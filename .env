# Vercel → Project → Settings → Environment Variables
# Добавьте для Production, Preview и Development, затем Redeploy.
#
# TELEGRAM_BOT_TOKEN — токен от @BotFather (формат: 123456789:ABC...)
# TELEGRAM_CHAT_ID   — ID чата или группы (число, для группы часто отрицательное)
#
# Проверка после деплоя: GET https://alkodostavka24.vercel.app/api/telegram
# Ответ {"ok":true,"configured":true} — переменные заданы.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пароль входа в админ-панель /admin/ (локально: npm run dev)
# На Vercel тоже задайте ADMIN_PASSWORD в Environment Variables.
ADMIN_PASSWORD=btt7prF7

# Vercel Blob — сохранение каталога на продакшене (alkodostavka24.vercel.app/admin/)
# 1) Vercel Dashboard → ваш проект → Storage → Create → Blob → Connect to Project
# 2) Redeploy проекта
# 3) Скопируйте токен сюда (Settings → Storage → Blob → .env.local) и выполните: npm run seed:blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Vercel → Project → Settings → Environment Variables
# Добавьте для Production, Preview и Development, затем Redeploy.
#
# TELEGRAM_BOT_TOKEN — токен от @BotFather (формат: 123456789:ABC...)
# TELEGRAM_CHAT_ID   — ID чата или группы (число, для группы часто отрицательное)
#
# Проверка после деплоя: GET https://alkodostavka24.vercel.app/api/telegram
# Ответ {"ok":true,"configured":true} — переменные заданы.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пароль входа в админ-панель /admin/ (локально: npm run dev)
ADMIN_PASSWORD=btt7prF7
